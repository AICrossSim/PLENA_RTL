*.str

# Synopsys / EDA outputs (not used in Docker)
tools/synopsys/analyzed/
tools/synopsys/outputs/
tools/alib-52/
.Xil

# Model / data blobs
*.pt
*.pth
*.bin
*.mem
ckpts_*

