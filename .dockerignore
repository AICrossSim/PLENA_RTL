.venv
**/.venv
.direnv
__pycache__
**/__pycache__
*.pyc
*.pyo
*.egg-info
.eggs
.pytest_cache

# Nix build outputs
result
result-*

# Build / simulation artifacts
build/
build_output/
temp/
